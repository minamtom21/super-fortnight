// ============================================================
// みなとみらいピッツァ - Power Fx Helper Formulas
// Drop these into the OnSelect / OnChange / OnVisible properties
// of the matching controls in your app.
// Assumes colProducts, colSizes, colCrusts, colToppings,
// colCoupons, colCart from collections.pfx are loaded.
// ============================================================

// ------------------------------------------------------------
// 1) Add a pizza to the cart (with size, crust, toppings, qty)
//    Use as: gallery / "Add to cart" button OnSelect.
//    Replace varSelectedProduct etc. with your own context vars.
// ------------------------------------------------------------
Set(varSelectedProduct, ThisItem);           // from product gallery
Set(varSelectedSize, "M");                   // from size dropdown
Set(varSelectedCrust, LookUp(colCrusts, CrustID = "regular"));
Set(varSelectedQty, 1);
// colSelectedToppings: a working collection of selected toppings
// (toggle items in/out in the toppings gallery)

Set(
    varUnitPrice,
    Switch(
        varSelectedSize,
        "S", varSelectedProduct.PriceS,
        "M", varSelectedProduct.PriceM,
        "L", varSelectedProduct.PriceL,
        varSelectedProduct.Price
    )
    + varSelectedCrust.ExtraPrice
    + Sum(colSelectedToppings, ExtraPrice)
);

Collect(
    colCart,
    {
        ProductID: varSelectedProduct.ProductID,
        Name:      varSelectedProduct.Name,
        Emoji:     varSelectedProduct.Emoji,
        Category:  varSelectedProduct.Category,
        SizeID:    If(varSelectedProduct.Category = "Pizza", varSelectedSize, ""),
        CrustID:   If(varSelectedProduct.Category = "Pizza", varSelectedCrust.CrustID, ""),
        Toppings:  colSelectedToppings,
        UnitPrice: varUnitPrice,
        Quantity:  varSelectedQty,
        LineTotal: varUnitPrice * varSelectedQty
    }
);
Clear(colSelectedToppings);

// ------------------------------------------------------------
// 2) Add a simple item (side / drink / dessert)
// ------------------------------------------------------------
Collect(
    colCart,
    {
        ProductID: ThisItem.ProductID,
        Name:      ThisItem.Name,
        Emoji:     ThisItem.Emoji,
        Category:  ThisItem.Category,
        SizeID:    "",
        CrustID:   "",
        Toppings:  Table(),
        UnitPrice: ThisItem.Price,
        Quantity:  1,
        LineTotal: ThisItem.Price
    }
);

// ------------------------------------------------------------
// 3) Change quantity on a cart line
//    Place on the +/- buttons inside the cart gallery.
// ------------------------------------------------------------
// + button:
Patch(
    colCart,
    ThisItem,
    {
        Quantity:  Min(20, ThisItem.Quantity + 1),
        LineTotal: ThisItem.UnitPrice * Min(20, ThisItem.Quantity + 1)
    }
);
// - button (removes when reaching 0):
If(
    ThisItem.Quantity <= 1,
    Remove(colCart, ThisItem),
    Patch(
        colCart,
        ThisItem,
        {
            Quantity:  ThisItem.Quantity - 1,
            LineTotal: ThisItem.UnitPrice * (ThisItem.Quantity - 1)
        }
    )
);

// ------------------------------------------------------------
// 4) Totals (use in Label.Text)
// ------------------------------------------------------------
// Subtotal:
"¥" & Text(Sum(colCart, LineTotal), "[$-ja-JP]#,##0")

// Cart count badge:
Sum(colCart, Quantity)

// ------------------------------------------------------------
// 5) Coupon discount
//    Bind to the "Apply coupon" button OnSelect.
//    txtCoupon.Text = user-entered code.
// ------------------------------------------------------------
Set(
    varCoupon,
    LookUp(colCoupons, Code = Upper(Trim(txtCoupon.Text)))
);

// Calculated discount (Label.Text or variable):
Set(
    varDiscount,
    With(
        { sub: Sum(colCart, LineTotal) },
        If(
            IsBlank(varCoupon) Or sub < varCoupon.MinSubtotal,
            0,
            If(
                varCoupon.DiscountType = "Percent",
                RoundDown(sub * varCoupon.Value / 100, 0),
                Min(varCoupon.Value, sub)
            )
        )
    )
);

// Total = subtotal - discount (delivery fee is ¥0):
Set(varTotal, Max(0, Sum(colCart, LineTotal) - varDiscount));

// ------------------------------------------------------------
// 6) Place order  (Submit button OnSelect)
//    Appends to colOrders. Replace with Patch() against a
//    SharePoint / Dataverse table for real persistence.
// ------------------------------------------------------------
Collect(
    colOrders,
    {
        OrderNumber: "MM-" & Text(Now(), "yyyymmdd") & "-" & Text(RandBetween(1000, 9999)),
        PlacedAt:    Now(),
        CustomerName: txtName.Text,
        Phone:       txtPhone.Text,
        Area:        ddArea.Selected.AreaName,
        Address:     txtAddress.Text,
        DeliveryTime: ddDeliveryTime.Selected.Label,
        Payment:     ddPayment.Selected.Label,
        Note:        txtNote.Text,
        Items:       ShowColumns(colCart, "ProductID", "Name", "SizeID", "CrustID", "Quantity", "UnitPrice", "LineTotal"),
        Subtotal:    Sum(colCart, LineTotal),
        CouponCode:  If(IsBlank(varCoupon), "", varCoupon.Code),
        Discount:    varDiscount,
        Total:       varTotal
    }
);
Clear(colCart);
Reset(txtCoupon);
Set(varCoupon, Blank());
Set(varDiscount, 0);
Navigate(ConfirmScreen, ScreenTransition.Fade);

// ------------------------------------------------------------
// 7) Filter products by category & search keyword
//    Use as Gallery.Items.
// ------------------------------------------------------------
Filter(
    colProducts,
    (varCategoryFilter = "All" Or Category = varCategoryFilter)
    && (
        IsBlank(txtSearch.Text)
        Or txtSearch.Text in Name
        Or txtSearch.Text in Description
    )
)
